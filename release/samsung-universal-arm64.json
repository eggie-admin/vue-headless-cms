{
  "schema": "luhmos.samsung-universal-arm64.v2",
  "date": "2026-09-15",
  "status": "testing_candidate",
  "application": {
    "name": "LuHm OS",
    "package_id": "art.eggiebagelface.luhmos",
    "version": "1.0.0",
    "version_code": 100,
    "abi": "arm64-v8a",
    "min_sdk": 24,
    "target_sdk": 36,
    "single_signed_apk": true,
    "play_aab_supported": true,
    "persistent_release_signer_required": true
  },
  "samsung_device_families": [
    {
      "name": "Galaxy S24 FE",
      "model_pattern": "SM-S721*",
      "role": "primary_phone_and_secure_folder_cockpit",
      "root_required": false,
      "secure_folder_supported_as_separate_app_instance": true
    },
    {
      "name": "Galaxy tablet testing lane",
      "model_pattern": "SM-X400",
      "role": "stock_tablet_play_keyboard_and_crown_gate_testing",
      "root_required": false
    },
    {
      "name": "Galaxy S10 Lite",
      "model_pattern": "SM-G770*",
      "role": "legacy_unrooted_phone_compatibility",
      "root_required": false,
      "runtime_model_verification_required": true
    }
  ],
  "secure_folder_boundary": {
    "same_signed_apk": true,
    "separate_profile_instance": true,
    "role": "protected_cockpit_client",
    "cross_profile_silent_install": false,
    "external_daemon_required": false,
    "termux_required": false,
    "signing_keys_in_profile": false
  },
  "root_of_trust": {
    "device_root_required": false,
    "persistent_signer_continuity": true,
    "git_commit_provenance": true,
    "ci_sha256_evidence": true,
    "play_delivery_preferred": true
  },
  "install_boundary": {
    "primary": {
      "channel": "google_play_internal",
      "artifact": "aab",
      "unknown_sources_required": false,
      "tester_enrollment_required_once": true,
      "play_store_handles_install_and_updates": true
    },
    "fallback": {
      "channel": "trusted_https_github_release_handoff",
      "android_user_confirmation_required": true,
      "unknown_sources_may_be_required": true
    },
    "request_install_packages_permission": false,
    "silent_install": false,
    "root_install": false,
    "same_signer_update_continuity": true
  },
  "compatibility_contract": {
    "screen_sizes": ["small", "normal", "large", "xlarge"],
    "orientation": "runtime_responsive",
    "device_snapshot_fields": ["manufacturer", "model", "sdk", "abi", "webview_package", "webview_version"],
    "unknown_samsung_models": "allow_when_arm64_and_sdk_at_or_above_minimum_then_require_smoke_test",
    "non_samsung_models": "not_part_of_this_compatibility_claim"
  }
}
