{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eggiebagelface.art/schemas/netplan-intent.schema.json",
  "title": "KAI 9000 Netplan Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface", "ipv4", "reason"],
  "properties": {
    "interface": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,32}$"
    },
    "ipv4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["dhcp", "static"]
        },
        "addresses": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "format": "ipv4-cidr"
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "via"],
            "properties": {
              "to": {"type": "string"},
              "via": {"type": "string", "format": "ipv4"},
              "metric": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        },
        "dns": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "static"}}},
          "then": {"required": ["addresses"]}
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_management_path": {
      "type": "string",
      "maxLength": 200
    },
    "change_ticket": {
      "type": "string",
      "maxLength": 100
    }
  }
}
