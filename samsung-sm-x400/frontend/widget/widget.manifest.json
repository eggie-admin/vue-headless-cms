{
  "schemaVersion": 1,
  "id": "samsung-sm-x400.frontend.widget",
  "optional": true,
  "target": {
    "manufacturer": "Samsung",
    "model": "SM-X400",
    "platform": "Android 16",
    "abi": "arm64-v8a"
  },
  "source": {
    "repository": "eggie-admin/hydra-shell-android",
    "mergeCommit": "0f7a58a52a832a2eb04c24f45fde6ded4974ec43"
  },
  "buildDependencies": {
    "python": ">=3.14",
    "node": ">=24.18 <25",
    "npm": "12.0.2",
