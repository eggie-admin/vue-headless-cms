{
  "manifest_version": "1.0.0",
  "project": "Video Forge Cathedral",
  "fqdn": {
    "apex": "eggiebagelface.art",
    "api": "api.eggiebagelface.art",
    "cms": "cms.eggiebagelface.art",
    "forge": "forge.eggiebagelface.art"
  },
  "ingress": {
    "public": "cloudflare_tunnel",
    "origin_bind": "127.0.0.1:8443",
    "origin_scheme": "https",
    "cloudflare_ssl_mode": "full_strict",
    "origin_tls_verify": true,
    "no_public_origin_ports": true,
    "ddos_edge": "cloudflare"
  },
  "identity": {
    "human_edge": "cloudflare_access",
    "idp": "google_or_google_workspace",
    "pkce": true,
    "google_iap_for_termux_origin": false,
    "machine_auth": "cloudflare_access_service_token",
    "session_policy": "short_lived",
    "token_transport": "https_headers_only"
  },
  "vpn": {
    "role": "break_glass_private_admin",
    "server_location": "trusted_ubuntu_or_gateway_not_termux",
    "tls_crypt_v2": true,
    "force_cookie": true,
    "per_device_certificates": true,
    "compression": false,
    "legacy_cipher_fallback": false,
    "app_ingress": false
  },
  "openssl": {
    "minimum_tls": "1.2",
    "prefer_tls": "1.3",
    "security_level": 2,
    "origin_certificate_validation": true,
    "private_ca_allowed_with_explicit_ca_pool": true
  },
  "secrets": {
    "values_in_repo": false,
    "values_in_apk": false,
    "token_query_parameters": false,
    "environment_or_protected_file_references_only": true
  }
}
