{
  "profile_version": "2.0.0",
  "name": "LuHm OS Samsung Universal Stock",
  "application": {
    "package_id": "art.eggiebagelface.luhmos",
    "abi": "arm64-v8a",
    "min_sdk": 24,
    "target_sdk": 36,
    "external_daemon_required": false,
    "root_required": false
  },
  "devices": {
    "s24_fe": {
      "model_pattern": "SM-S721*",
      "role": "primary_phone_and_secure_folder_client",
      "ui": "godot_plus_packaged_vue_webview"
    },
    "sm_x400": {
      "model_pattern": "SM-X400",
      "role": "stock_tablet_testing",
      "ui": "godot_plus_packaged_vue_webview"
    },
    "s10_lite": {
      "model_pattern": "SM-G770*",
      "role": "stock_compatibility_phone",
      "ui": "godot_plus_packaged_vue_webview"
    }
  },
  "secure_folder": {
    "role": "protected_cockpit_client",
    "same_signed_apk": true,
    "separate_profile_data": true,
    "cross_profile_silent_install": false,
    "build_forge_inside_profile": false,
    "signing_keys_inside_profile": false
  },
  "widget": {
    "provider": "CathedralWidgetProvider",
    "controls": ["on", "off", "smoke", "background_guard", "benchmark", "developer_options"],
    "title_tap": "open_app",
    "explicit_on_off": true,
    "blind_toggle": false,
    "lifecycle_authority": "android_os",
    "external_shell_bridge": false
  },
  "background_guard": {
    "surface": "samsung_never_sleeping_apps",
    "deeplink_action": "com.samsung.android.sm.ACTION_OPEN_CHECKABLE_LISTACTIVITY",
    "activity_type": 2,
    "requires_user_selection": true,
    "generic_fallback": "android_ignore_battery_optimization_settings",
    "no_accessibility_ui_automation": true,
    "no_hidden_samsung_database_writes": true
  },
  "developer_mode": {
    "baseline": "open_system_settings_only",
    "read_global_toggle": false,
    "write_secure_settings": false
  },
  "kiosk": {
    "baseline": "app_local_immersive_shell",
    "lock_task_requires": "device_owner_or_affiliated_profile_owner",
    "knox_prokiosk": "optional_enterprise_lane"
  },
  "webview": {
    "production_channel": "stable",
    "compatibility_test_channels": ["beta", "dev"],
    "canary": "manual_only",
    "provider_switch": "webview_devtools",
    "remote_debug": "debug_builds_only"
  },
  "rendering": {
    "godot_primary": "mobile_vulkan",
    "compatibility_fallback": true,
    "physical_device_gate": true
  },
  "distribution": {
    "bootstrap": "https://github.com/eggie-admin/hydra-shell-android/releases/latest",
    "android_user_confirmation_required": true,
    "request_install_packages_permission": false,
    "same_signer_update_required": true,
    "google_play_testing_allowed": true,
    "fdroid_optional_after_promotion": true
  },
  "legacy_termux_lane": {
    "status": "historical_development_only",
    "production_runtime_dependency": false,
    "run_command_permission_allowed_in_production_apk": false
  },
  "benchmark": {
    "stock_smoke": ["launcher", "webview", "vulkan_properties", "device_snapshot", "offline_boot"],
    "physical_device_required": true,
    "public_network_targets": false
  },
  "doctrine": "universal_stock_standalone"
}
