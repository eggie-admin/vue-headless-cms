; KAI 9000 / LuHm OS Godot Android shell
config_version=5

[application]
config/name="KAI 9000"
run/main_scene="res://scenes/main.tscn"

[display/window]
; Portrait design-space only. Android/Samsung owns the real window size and density.
size/viewport_width=1080
size/viewport_height=1920
handheld/orientation=1
stretch/mode="canvas_items"
stretch/aspect="expand"
subwindows/embed_subwindows=true

[editor_plugins]
enabled=PackedStringArray("res://addons/CathedralAndroid/plugin.cfg")

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
