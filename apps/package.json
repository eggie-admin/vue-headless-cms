{
  "name": "luhm-os-web-workspace",
  "private": true,
  "version": "0.2.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.19 <13"
  },
  "workspaces": [
    "forge-ui"
  ],
  "scripts": {
    "build": "npm run build --workspace=luhm-os-ui",
    "dev": "npm run dev --workspace=luhm-os-ui",
    "preview": "npm run preview --workspace=luhm-os-ui",
    "format": "prettier --write \"forge-ui/**/*.{html,css,ts,vue,json}\"",
    "format:check": "prettier --check \"forge-ui/**/*.{html,css,ts,vue,json}\"",
    "backend:install": "python3 -m pip install -e ../server",
    "backend:smoke": "python3 ../scripts/backend_smoke.py",
    "backend:install-smoke": "npm run backend:install && npm run backend:smoke",
    "samsung:smoke": "python3 ../scripts/samsung_benchmark.py --smoke",
    "samsung:bench": "python3 ../scripts/samsung_benchmark.py --full",
    "samsung:guard:adb": "bash ../scripts/samsung_background_guard_adb.sh",
    "widget:check": "python3 ../scripts/sm_x400_widget_build.py --check",
    "widget:build": "python3 ../scripts/sm_x400_widget_build.py --build",
    "widget:runtime": "python3 ../scripts/sm_x400_widget_build.py --check --runtime-check",
    "wizard": "python3 ../scripts/sm_x400_build_wizard.py",
    "candidate:build": "python3 ../scripts/sm_x400_build_wizard.py --candidate",
    "candidate:build:widget": "python3 ../scripts/sm_x400_build_wizard.py --candidate --with-widget"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
