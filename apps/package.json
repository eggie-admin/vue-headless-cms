{
  "name": "video-forge-web-workspace",
  "private": true,
  "version": "0.2.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.19 <13"
  },
  "workspaces": [
    "forge-ui"
  ],
  "scripts": {
    "build": "npm run build --workspace=video-forge-ui",
    "dev": "npm run dev --workspace=video-forge-ui",
    "preview": "npm run preview --workspace=video-forge-ui",
    "format": "prettier --write \"forge-ui/**/*.{html,css,ts,vue,json}\"",
    "format:check": "prettier --check \"forge-ui/**/*.{html,css,ts,vue,json}\"",
    "backend:install": "python3 -m pip install -e ../server",
    "backend:smoke": "python3 ../scripts/backend_smoke.py",
    "backend:install-smoke": "npm run backend:install && npm run backend:smoke",
    "samsung:smoke": "python3 ../scripts/samsung_benchmark.py --smoke",
    "samsung:smoke:adb": "python3 ../scripts/samsung_device_smoke_adb.py",
    "samsung:bench": "python3 ../scripts/samsung_benchmark.py --full",
    "samsung:guard:adb": "bash ../scripts/samsung_background_guard_adb.sh",
    "samsung:bark": "bash ../scripts/samsung_bark_test.sh",
    "samsung:kiosk:status": "bash ../scripts/samsung_kiosk_adb.sh status",
    "samsung:kiosk:guard": "bash ../scripts/samsung_kiosk_adb.sh guard",
    "samsung:kiosk:launch": "bash ../scripts/samsung_kiosk_adb.sh launch",
    "samsung:qualify": "npm run samsung:smoke && npm run samsung:bench",
    "samsung:qualify:device": "npm run samsung:smoke:adb && npm run samsung:kiosk:status && npm run samsung:bark",
    "samsung:qualify:bark": "npm run samsung:guard:adb && npm run samsung:bark"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
