{
  "name": "video-forge-web-workspace",
  "private": true,
  "version": "0.2.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.19 <13"
  },
  "workspaces": [
    "forge-ui"
  ],
  "scripts": {
    "build": "npm run build --workspace=video-forge-ui",
    "dev": "npm run dev --workspace=video-forge-ui",
    "preview": "npm run preview --workspace=video-forge-ui",
    "backend:install": "python3 -m pip install -e ../server",
    "backend:smoke": "python3 ../scripts/backend_smoke.py",
    "backend:install-smoke": "npm run backend:install && npm run backend:smoke"
  }
}
